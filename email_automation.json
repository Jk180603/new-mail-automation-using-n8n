{
  "name": "Inbox Triage Agent",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {}
      },
      "id": "1a1b1c1d-0001-4a1a-8a1a-000000000001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [
        -600,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "REPLACE_WITH_YOUR_GEMINI_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { text: \"Read this email and decide the single best next action from this list:\\n- REPLY: it's a simple question you can answer from common knowledge\\n- SCHEDULE: it's requesting a meeting or has a date/time to act on\\n- ESCALATE: it needs a human (complaint, unclear, high-stakes)\\n- TASK: it's an action item someone needs to do later, not now\\n\\nEmail subject: \" + $json.subject + \"\\nEmail body: \" + ($json.text || $json.snippet || '') + \"\\n\\nReturn ONLY valid JSON, no explanation, no markdown fences:\\n{\\\"action\\\": \\\"REPLY | SCHEDULE | ESCALATE | TASK\\\", \\\"reasoning\\\": \\\"one sentence\\\", \\\"draft_reply\\\": \\\"string or null\\\", \\\"task_title\\\": \\\"string or null\\\"}\" } ] } ] }) }}",
        "options": {}
      },
      "id": "1a1b1c1d-0002-4a1a-8a1a-000000000002",
      "name": "Gemini Reasoning",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -380,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst cleaned = raw.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { action: 'ESCALATE', reasoning: 'Failed to parse model output: ' + cleaned.slice(0, 200), draft_reply: null, task_title: null };\n}\nconst trigger = $('Gmail Trigger').first().json;\nreturn [{\n  json: {\n    ...parsed,\n    subject: trigger.subject,\n    from: trigger.from ? trigger.from.value ? trigger.from.value[0].address : trigger.from : '',\n    messageId: trigger.id\n  }\n}];"
      },
      "id": "1a1b1c1d-0003-4a1a-8a1a-000000000003",
      "name": "Parse Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "REPLY",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "REPLY"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "SCHEDULE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "SCHEDULE"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "ESCALATE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "ESCALATE"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "TASK",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "TASK"
            }
          ]
        },
        "options": {
          "fallbackOutput": "ESCALATE"
        }
      },
      "id": "1a1b1c1d-0004-4a1a-8a1a-000000000004",
      "name": "Route By Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        60,
        0
      ]
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "={{ \"Re: \" + $json.subject }}",
        "message": "={{ $json.draft_reply }}",
        "options": {
          "threadId": "={{ $json.messageId }}"
        }
      },
      "id": "1a1b1c1d-0005-4a1a-8a1a-000000000005",
      "name": "Draft Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        300,
        -300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "calendar": {
          "mode": "list",
          "value": "REPLACE_WITH_YOUR_CALENDAR_ID"
        },
        "start": "={{ $now.plus(1, 'day').toISO() }}",
        "end": "={{ $now.plus(1, 'day').plus(30, 'minutes').toISO() }}",
        "additionalFields": {
          "summary": "={{ 'Tentative: ' + $json.subject }}",
          "description": "={{ 'Auto-created by Inbox Triage Agent. Reasoning: ' + $json.reasoning }}"
        }
      },
      "id": "1a1b1c1d-0006-4a1a-8a1a-000000000006",
      "name": "Create Tentative Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        300,
        -100
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CALENDAR_CREDENTIAL",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "REPLACE_WITH_YOUR_OWN_EMAIL",
        "subject": "={{ 'Agent Escalation: ' + $json.subject }}",
        "message": "={{ 'From: ' + $json.from + '\\n\\nAgent reasoning: ' + $json.reasoning + '\\n\\nThis needs a human look.' }}",
        "options": {}
      },
      "id": "1a1b1c1d-0007-4a1a-8a1a-000000000007",
      "name": "Escalate To Me",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        300,
        100
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "mode": "list",
          "value": "REPLACE_WITH_YOUR_SHEET_ID"
        },
        "sheetName": {
          "mode": "list",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Task": "={{ $json.task_title }}",
            "Source Email": "={{ $json.subject }}",
            "From": "={{ $json.from }}",
            "Reasoning": "={{ $json.reasoning }}",
            "Created": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "1a1b1c1d-0008-4a1a-8a1a-000000000008",
      "name": "Log Task",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        300,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_SHEETS_CREDENTIAL",
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [
        [
          {
            "node": "Gemini Reasoning",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini Reasoning": {
      "main": [
        [
          {
            "node": "Parse Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Decision": {
      "main": [
        [
          {
            "node": "Route By Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route By Action": {
      "main": [
        [
          {
            "node": "Draft Reply",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Create Tentative Event",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Escalate To Me",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}