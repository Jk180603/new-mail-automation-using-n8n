      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "mode": "list",
          "value": "REPLACE_WITH_YOUR_SHEET_ID"
        },
        "sheetName": {
          "mode": "list",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Task": "={{ $json.task_title || '(untitled task)' }}",
            "Source Email": "={{ $json.subject }}",
            "From": "={{ $json.from }}",
            "Reasoning": "={{ $json.reasoning }}",
            "Created": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "1a1b1c1d-0008-4a1a-8a1a-000000000008",
      "name": "Log Task",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        520,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_SHEETS_CREDENTIAL",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "content": "## No auto-scheduling\nThis branch used to create a Google Calendar event by itself.\n\nIt now just emails you the details so you approve + book it manually — nothing touches your calendar.",
        "height": 180,
        "width": 280
      },
      "id": "1a1b1c1d-000c-4a1a-8a1a-00000000000c",
      "name": "Sticky Note - Scheduling",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        520,
        -340
      ]
    }
  ],
