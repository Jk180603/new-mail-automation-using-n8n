{
  "name": "Inbox Triage Agent (Safe Demo Mode)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": true,
        "filters": {}
      },
      "id": "1a1b1c1d-0001-4a1a-8a1a-000000000001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [
        -820,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "content": "## 🔒 Demo Safety Guard\nEverything below the trigger only runs if the sender's address matches the test email set in \"Is Test Sender\".\n\nSend test emails from your OTHER inbox to trigger the demo — real inbox mail is ignored.",
        "height": 220,
        "width": 320
      },
      "id": "1a1b1c1d-000b-4a1a-8a1a-00000000000b",
      "name": "Sticky Note - Safety Guard",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -820,
        -320
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const trigger = $json;\nconst fromRaw = trigger.From || trigger.from || '';\nlet senderEmail = typeof fromRaw === 'string' ? fromRaw : (fromRaw.text || '');\n\nconst match = senderEmail.match(/<([^>]+)>/);\nif (match) senderEmail = match[1];\n\nreturn {\n  json: {\n    ...trigger,\n    senderEmail: senderEmail.toLowerCase().trim()\n  }\n};"
      },
      "id": "1a1b1c1d-0009-4a1a-8a1a-000000000009",
      "name": "Extract Sender",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.senderEmail }}",
              "rightValue": "replace_with_your_test_sender_email@example.com",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a1b1c1d-000a-4a1a-8a1a-00000000000a",
      "name": "Is Test Sender",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -380,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "REPLACE_WITH_YOUR_GEMINI_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { text: \"Read this email and decide the single best next action from this list:\\n- REPLY: it's a simple question you can answer from common knowledge\\n- SCHEDULE: it's requesting a meeting or has a date/time to act on\\n- ESCALATE: it needs a human (complaint, unclear, high-stakes)\\n- TASK: it's an action item someone needs to do later, not now\\n\\nEmail subject: \" + ($json.Subject || $json.subject || '') + \"\\nEmail body: \" + ($json.text || $json.snippet || '') + \"\\n\\nReturn ONLY valid JSON, no explanation, no markdown fences:\\n{\\\"action\\\": \\\"REPLY | SCHEDULE | ESCALATE | TASK\\\", \\\"reasoning\\\": \\\"one sentence\\\", \\\"draft_reply\\\": \\\"string or null\\\", \\\"task_title\\\": \\\"string or null\\\"}\" } ] } ] }) }}",
        "options": {}
      },
      "id": "1a1b1c1d-0002-4a1a-8a1a-000000000002",
      "name": "Gemini Reasoning",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -160,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response = $json;\nconst trigger = $('Gmail Trigger').item.json;\nconst senderEmail = $('Extract Sender').item.json.senderEmail;\n\nlet parsed;\ntry {\n  const candidate = response.candidates && response.candidates[0];\n  const raw = candidate && candidate.content && candidate.content.parts && candidate.content.parts[0]\n    ? candidate.content.parts[0].text\n    : null;\n\n  if (!raw) {\n    throw new Error('No text returned by Gemini. Full response: ' + JSON.stringify(response).slice(0, 300));\n  }\n\n  const cleaned = raw.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n\n  if (!['REPLY', 'SCHEDULE', 'ESCALATE', 'TASK'].includes(parsed.action)) {\n    throw new Error('Model returned an unrecognised action: ' + parsed.action);\n  }\n} catch (e) {\n  parsed = {\n    action: 'ESCALATE',\n    reasoning: 'Failed to get a usable decision from the model: ' + e.message,\n    draft_reply: null,\n    task_title: null\n  };\n}\n\nreturn {\n  json: {\n    ...parsed,\n    subject: trigger.Subject || trigger.subject,\n    from: senderEmail,\n    messageId: trigger.id\n  }\n};"
      },
      "id": "1a1b1c1d-0003-4a1a-8a1a-000000000003",
      "name": "Parse Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        60,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "REPLY",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "REPLY"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "SCHEDULE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "SCHEDULE"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "ESCALATE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "ESCALATE"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "TASK",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "TASK"
            }
          ]
        },
        "options": {
          "fallbackOutput": "ESCALATE"
        }
      },
      "id": "1a1b1c1d-0004-4a1a-8a1a-000000000004",
      "name": "Route By Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        280,
        0
      ]
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "={{ \"Re: \" + $json.subject }}",
        "message": "={{ $json.draft_reply || ('(No draft text was generated. Reasoning: ' + $json.reasoning + ')') }}",
        "options": {
          "threadId": "={{ $json.messageId }}"
        }
      },
      "id": "1a1b1c1d-0005-4a1a-8a1a-000000000005",
      "name": "Draft Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        520,
        -300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "REPLACE_WITH_YOUR_OWN_EMAIL",
        "subject": "={{ 'Approval needed: schedule this? — ' + $json.subject }}",
        "message": "={{ 'From: ' + $json.from + '\\n\\nThe agent thinks this email needs a calendar event.\\nReasoning: ' + $json.reasoning + '\\n\\nOriginal subject: ' + $json.subject + '\\n\\nNo event has been created — this workflow never books your calendar automatically. Open the original email, decide the time, and add it yourself.' }}",
        "options": {}
      },
      "id": "1a1b1c1d-0006-4a1a-8a1a-000000000006",
      "name": "Ask Me To Schedule",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        520,
        -100
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "REPLACE_WITH_YOUR_OWN_EMAIL",
        "subject": "={{ 'Agent Escalation: ' + $json.subject }}",
        "message": "={{ 'From: ' + $json.from + '\\n\\nAgent reasoning: ' + $json.reasoning + '\\n\\nThis needs a human look.' }}",
        "options": {}
      },
      "id": "1a1b1c1d-0007-4a1a-8a1a-000000000007",
      "name": "Escalate To Me",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
